# Copy to .env and fill in. Don't commit .env to git.
#
# Headscale config that's static (won't change at runtime). DNS / server_url /
# TLS are managed by the panel and live in ./config/config.yaml.

# --- Listeners ---
HEADSCALE_LISTEN_ADDR=0.0.0.0:8080
HEADSCALE_METRICS_LISTEN_ADDR=127.0.0.1:9090
HEADSCALE_GRPC_LISTEN_ADDR=127.0.0.1:50443
HEADSCALE_GRPC_ALLOW_INSECURE=false

# --- Tailnet IP pool ---
HEADSCALE_PREFIXES_V4=100.64.0.0/10
HEADSCALE_PREFIXES_V6=fd7a:115c:a1e0::/48

# --- Database ---
HEADSCALE_DATABASE_TYPE=sqlite
HEADSCALE_DATABASE_SQLITE_PATH=/var/lib/headscale/db.sqlite

# --- Crypto identity (file on disk; persists across restarts) ---
HEADSCALE_NOISE_PRIVATE_KEY_PATH=/var/lib/headscale/noise_private.key

# --- ACL policy stored in DB (no acl_policy.hujson file) ---
HEADSCALE_POLICY_MODE=database

# --- DERP: embedded server off; use Tailscale's public DERP map ---
HEADSCALE_DERP_SERVER_ENABLED=false
HEADSCALE_DERP_URLS=https://controlplane.tailscale.com/derpmap/default
HEADSCALE_DERP_AUTO_UPDATE_ENABLED=true
HEADSCALE_DERP_UPDATE_FREQUENCY=24h

# --- TLS off here; managed via /settings on the panel ---
HEADSCALE_TLS_LETSENCRYPT_HOSTNAME=
HEADSCALE_TLS_LETSENCRYPT_LISTEN=
HEADSCALE_TLS_CERT_PATH=
HEADSCALE_TLS_KEY_PATH=

# --- Misc ---
HEADSCALE_LOG_LEVEL=info
HEADSCALE_DISABLE_CHECK_UPDATES=true
HEADSCALE_EPHEMERAL_NODE_INACTIVITY_TIMEOUT=30m
HEADSCALE_UNIX_SOCKET=/var/run/headscale/headscale.sock
HEADSCALE_UNIX_SOCKET_PERMISSION=0770

# --- Panel ---
PANEL_DB_PATH=/data/panel.sqlite

# Defaults assume containers are named "headscale" and "headscale-panel".
# Override if your compose.yaml uses different container_name values.
PANEL_HEADSCALE_URL=http://headscale:8080
PANEL_HEADSCALE_CONTAINER=headscale

# Set to false if PANEL_HEADSCALE_URL points at a hostname that doesn't match
# Headscale's TLS certificate (e.g. https://localhost when the cert is for a
# public hostname). Only safe when the request never leaves the host.
PANEL_HEADSCALE_VERIFY_TLS=true

# REQUIRED: generate a Headscale API key after first boot:
#   docker exec headscale headscale apikeys create --expiration 99y
# Paste the resulting hskey-api-... value below.
PANEL_HEADSCALE_API_KEY=

# Bootstrap admin: created on first start if no panel users exist yet.
# Pick a strong password and remove this line after first login.
PANEL_BOOTSTRAP_USER=admin
PANEL_BOOTSTRAP_PASSWORD=changeme-on-first-login

PANEL_TOTP_ISSUER=Headscale Panel
PANEL_SESSION_COOKIE=panel_session
PANEL_SESSION_LIFETIME_SECS=86400

# Set to true when serving the panel over HTTPS.
PANEL_SECURE_COOKIES=false
